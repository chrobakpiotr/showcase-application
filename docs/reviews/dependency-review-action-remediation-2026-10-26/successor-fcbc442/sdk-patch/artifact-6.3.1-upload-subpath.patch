+import {warning} from '@actions/core'
+import {isGhes} from './internal/shared/config.js'
+import {uploadArtifact as uploadArtifactInternal} from './internal/upload/upload-artifact.js'
+import {GHESNotSupportedError} from './internal/shared/errors.js'
+
+/** Uploads an artifact without importing the download client. */
+export async function uploadArtifact(name, files, rootDirectory, options) {
+  try {
+    if (isGhes()) {
+      throw new GHESNotSupportedError()
+    }
+    return uploadArtifactInternal(name, files, rootDirectory, options)
+  } catch (error) {
+    warning(`Artifact upload failed with error: ${error}.\n\nErrors can be temporary, so please try again and optionally run the action with debug mode enabled for more information.\n\nIf the error persists, please check whether Actions is operating normally at [https://githubstatus.com](https://www.githubstatus.com).`)
+    throw error
+  }
+}
