--- /dev/null
+++ b/tooling/scripts/tests/test_validate_dependency_review_push_refs.py
@@ -0,0 +1,28 @@
+import unittest
+
+from tooling.scripts.validate_dependency_review_push_refs import validate_push_refs
+
+
+class ValidateDependencyReviewPushRefsTest(unittest.TestCase):
+    def test_accepts_full_nonzero_before_and_head_shas(self):
+        validate_push_refs("1" * 40, "a" * 40)
+
+    def test_rejects_zero_before_sha(self):
+        with self.assertRaisesRegex(ValueError, "nonzero full before SHA"):
+            validate_push_refs("0" * 40, "a" * 40)
+
+    def test_rejects_missing_or_abbreviated_before_sha(self):
+        for base_sha in ("", "abcd"):
+            with self.subTest(base_sha=base_sha):
+                with self.assertRaisesRegex(ValueError, "nonzero full before SHA"):
+                    validate_push_refs(base_sha, "a" * 40)
+
+    def test_rejects_invalid_head_sha(self):
+        for head_sha in ("", "0" * 40, "xyz" * 13 + "x"):
+            with self.subTest(head_sha=head_sha):
+                with self.assertRaisesRegex(ValueError, "nonzero full head SHA"):
+                    validate_push_refs("1" * 40, head_sha)
+
+
+if __name__ == "__main__":
+    unittest.main()
