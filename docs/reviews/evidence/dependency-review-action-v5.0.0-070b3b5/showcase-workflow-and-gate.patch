diff --git a/tooling/scripts/validate_dependency_review_push_refs.py b/tooling/scripts/validate_dependency_review_push_refs.py
new file mode 100644
index 0000000..69ac401
--- /dev/null
+++ b/tooling/scripts/validate_dependency_review_push_refs.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+
+"""Reject push events without a valid, comparable before/after SHA range."""
+
+from __future__ import annotations
+
+import os
+import re
+import sys
+
+_FULL_SHA = re.compile(r"[0-9a-f]{40}\Z")
+_ZERO_SHA = "0" * 40
+
+
+def validate_push_refs(base_sha: str, head_sha: str) -> None:
+    if not _FULL_SHA.fullmatch(base_sha) or base_sha == _ZERO_SHA:
+        raise ValueError("push dependency review requires a nonzero full before SHA")
+    if not _FULL_SHA.fullmatch(head_sha) or head_sha == _ZERO_SHA:
+        raise ValueError("push dependency review requires a nonzero full head SHA")
+
+
+def main() -> int:
+    try:
+        validate_push_refs(
+            os.environ.get("BASE_SHA", ""),
+            os.environ.get("HEAD_SHA", ""),
+        )
+    except ValueError as error:
+        print(f"::error::{error}")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
