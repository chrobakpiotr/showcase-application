 jest.mock('@actions/core', () => {
   const summary = {
     addRaw: jest.fn().mockReturnThis(),
@@ -162,3 +163,111 @@ describe('handleLargeSummary', () => {
     )
   })
 })
+
+describe('snapshot warnings', () => {
+  beforeEach(() => {
+    process.env.GITHUB_REPOSITORY = 'owner/repository'
+  })
+
+  const compareMock = dependencyGraph.compare as jest.MockedFunction<
+    typeof dependencyGraph.compare
+  >
+
+  afterEach(() => {
+    jest.useRealTimers()
+    compareMock.mockReset()
+  })
+
+  test('fails closed when warnings remain and retry is disabled', async () => {
+    compareMock.mockResolvedValue({
+      changes: [],
+      snapshot_warnings: 'snapshot missing'
+    })
+
+    await expect(
+      getComparison('base-sha', 'head-sha', undefined, true)
+    ).rejects.toThrow(/snapshot.*incomplete/i)
+    expect(compareMock).toHaveBeenCalledTimes(1)
+  })
+
+  test('fails closed when warnings remain after retry timeout', async () => {
+    jest.useFakeTimers()
+    const retryUntil = Date.now() + 5_000
+    compareMock.mockResolvedValue({
+      changes: [],
+      snapshot_warnings: 'snapshot missing'
+    })
+
+    const result = getComparison(
+      'base-sha',
+      'head-sha',
+      {retryUntil, retryDelay: 10},
+      true
+    )
+    const assertion = expect(result).rejects.toThrow(/snapshot.*incomplete/i)
+    await jest.advanceTimersByTimeAsync(10_000)
+
+    await assertion
+    expect(compareMock).toHaveBeenCalledTimes(2)
+  })
+
+  test('evaluates the warning-free comparison returned after retry', async () => {
+    jest.useFakeTimers()
+    const retryUntil = Date.now() + 20_000
+    const first = {changes: [], snapshot_warnings: 'snapshot pending'}
+    const resolved = {
+      changes: [
+        {
+          change_type: 'added' as const,
+          manifest: 'package.json',
+          ecosystem: 'npm',
+          name: 'example',
+          version: '1.0.0',
+          package_url: 'pkg:npm/example@1.0.0',
+          license: null,
+          source_repository_url: null,
+          vulnerabilities: [
+            {
+              severity: 'high' as const,
+              advisory_ghsa_id: 'GHSA-test-test-test',
+              advisory_summary: 'test advisory',
+              advisory_url: 'https://example.test/advisory'
+            }
+          ]
+        }
+      ],
+      snapshot_warnings: ''
+    }
+    compareMock.mockResolvedValueOnce(first).mockResolvedValueOnce(resolved)
+
+    const result = getComparison(
+      'base-sha',
+      'head-sha',
+      {retryUntil, retryDelay: 10},
+      true
+    )
+    const assertion = expect(result).resolves.toBe(resolved)
+    await jest.advanceTimersByTimeAsync(10_000)
+
+    await assertion
+    expect(compareMock).toHaveBeenCalledTimes(2)
+    expect(resolved.changes[0]?.vulnerabilities[0]?.severity).toBe('high')
+  })
+
+  test('preserves API errors as failures', async () => {
+    compareMock.mockRejectedValue(
+      new Error('dependency graph API returned 403')
+    )
+
+    await expect(
+      getComparison('base-sha', 'head-sha', undefined, true)
+    ).rejects.toThrow('dependency graph API returned 403')
+  })
+
+  test('keeps default behavior when fail-on-snapshot-warnings is false', async () => {
+    const response = {changes: [], snapshot_warnings: 'snapshot missing'}
+    compareMock.mockResolvedValue(response)
+
+    await expect(getComparison('base-sha', 'head-sha')).resolves.toBe(response)
+  })
+})
