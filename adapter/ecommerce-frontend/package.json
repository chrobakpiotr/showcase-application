    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/router": "22.1.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@eslint/js": "9.39.5",
    "@types/jasmine": "4.3.1",
    "@types/node": "18.14.0",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "4.5.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.0.12",
    "minimatch@>=4": {
      "brace-expansion": "^5.0.8"
