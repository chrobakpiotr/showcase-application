<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="34" author="cp">

        <createTable schemaName="${schema_name_full}" tableName="NOTIFICATION">
            <column name="NOTIFICATION_ID" remarks="Business/primary key, mirrors NOTIF-&lt;uuid&gt; style identifiers" type="VARCHAR(42)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NOTIFICATION" />
            </column>
            <column name="RECIPIENT_EMAIL" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="CHANNEL" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="TYPE" type="VARCHAR(30)">
                <constraints nullable="false" />
            </column>
            <column name="SUBJECT" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="BODY" type="VARCHAR(2000)">
                <constraints nullable="false" />
            </column>
            <column name="STATUS" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="CREATED_DATE" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="SENT_DATE" type="TIMESTAMP" />
        </createTable>

        <createIndex indexName="IDX_NOTIFICATION_RECIPIENT" schemaName="${schema_name_full}" tableName="NOTIFICATION">
            <column name="RECIPIENT_EMAIL" />
            <column name="CREATED_DATE" />
        </createIndex>

        <createIndex indexName="IDX_NOTIFICATION_STATUS" schemaName="${schema_name_full}" tableName="NOTIFICATION">
            <column name="STATUS" />
            <column name="CREATED_DATE" />
        </createIndex>

    </changeSet>

</databaseChangeLog>
