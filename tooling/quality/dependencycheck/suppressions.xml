<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      CVE-2015-0897 affects the LINE Android/iOS application, not PIT.
      Dependency-Check associates pitest-command-line with cpe:2.3:a:line:line
      because of a product-name/CPE collision.
      Review expiry: 2027-03-19.
    -->
    <suppress until="2027-03-19Z">
        <notes><![CDATA[
        False positive: org.pitest:pitest-command-line is the PIT mutation-testing CLI.
        CVE-2015-0897 affects LINE for Android/iOS and is unrelated to PIT.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.pitest/pitest-command-line@.*$</packageUrl>
        <cve>CVE-2015-0897</cve>
    </suppress>

    <!--
      These CVEs affect OpenTelemetry implementations in other ecosystems:
        CVE-2026-39882 - OpenTelemetry Go
        CVE-2026-40894 - OpenTelemetry .NET
        CVE-2026-41178 - OpenTelemetry Go
        CVE-2026-44967 - OpenTelemetry C++
        CVE-2026-54285 - OpenTelemetry JavaScript

      Dependency-Check maps Java Maven artifacts to the broad
      cpe:2.3:a:opentelemetry:opentelemetry CPE and therefore reports them
      against io.opentelemetry / io.opentelemetry.proto Java artifacts.
      Only these five CVEs are suppressed; future Java/OpenTelemetry findings
      remain visible. Review expiry: 2027-03-19.
    -->
    <suppress until="2027-03-19Z">
        <notes><![CDATA[
        False-positive ecosystem collision for io.opentelemetry Java Maven artifacts.
        The listed CVEs affect Go/.NET/C++/JavaScript implementations, not OpenTelemetry Java.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry/.*@.*$</packageUrl>
        <cve>CVE-2026-39882</cve>
        <cve>CVE-2026-40894</cve>
        <cve>CVE-2026-41178</cve>
        <cve>CVE-2026-44967</cve>
        <cve>CVE-2026-54285</cve>
    </suppress>

    <suppress until="2027-03-19Z">
        <notes><![CDATA[
        False-positive ecosystem collision for io.opentelemetry.proto Java Maven artifacts.
        The listed CVEs affect Go/.NET/C++/JavaScript implementations, not the Java protobuf artifact.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry\.proto/.*@.*$</packageUrl>
        <cve>CVE-2026-39882</cve>
        <cve>CVE-2026-40894</cve>
        <cve>CVE-2026-41178</cve>
        <cve>CVE-2026-44967</cve>
        <cve>CVE-2026-54285</cve>
    </suppress>

    <!--
      CVE-2022-31691 affects Spring Tools 4 for Eclipse and the Spring Boot
      Tools VSCode extension. It does not affect the spring-boot-devtools
      Maven module. Dependency-Check matched the Maven artifact to the
      spring_boot_tools/spring_tools CPEs. Review expiry: 2027-03-19.
    -->
    <suppress until="2027-03-19Z">
        <notes><![CDATA[
        False positive: CVE-2022-31691 is an IDE/editor-extension vulnerability,
        not a vulnerability in org.springframework.boot:spring-boot-devtools.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-devtools@.*$</packageUrl>
        <cve>CVE-2022-31691</cve>
    </suppress>

</suppressions>
