{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_hash": {
      "type": "string",
      "minLength": 1
    },
    "policy_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "candidate_identity": {
      "type": "string",
      "minLength": 1
    },
    "final_changed_surface_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_binding": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 2
    },
    "task_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 1
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "minLength": 1
        },
        "origin_policy": {
          "type": "string",
          "minLength": 1
        },
        "profile_hash": {
          "type": "string",
          "minLength": 1
        },
        "policy_checkpoint": {
          "type": "string",
          "minLength": 1
        },
        "candidate_identity": {
          "type": "string",
          "minLength": 1
        },
        "final_changed_surface_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "base_sha",
        "origin_policy",
        "profile_hash",
        "policy_checkpoint",
        "candidate_identity",
        "final_changed_surface_id"
      ]
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_source": {
            "enum": [
              "task-command",
              "profile"
            ]
          },
          "required_origin": {
            "enum": [
              "task",
              "independent"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "command_hash": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "retry_policy": {
            "enum": [
              "forbid",
              "allow"
            ]
          },
          "sandbox": {
            "enum": [
              "required",
              "best-effort",
              "off"
            ]
          },
          "profile_gate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurrence": {
            "type": "boolean"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "independent_execution_class": {
            "enum": [
              null,
              "harness-managed-independent-execution-v1"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "critical": {
            "type": "boolean"
          },
          "retry_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "obligation_id",
          "family_id",
          "gate_id",
          "requirement_source",
          "required_origin",
          "command",
          "command_hash",
          "cwd",
          "retry_policy",
          "sandbox",
          "profile_gate_id",
          "occurrence",
          "ordinal",
          "independent_execution_class",
          "dependencies",
          "critical",
          "retry_controls"
        ]
      }
    },
    "execution_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "obligation_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_origin": {
            "enum": [
              "task",
              "independent"
            ]
          },
          "independent_execution_class": {
            "enum": [
              null,
              "harness-managed-independent-execution-v1"
            ]
          }
        },
        "required": [
          "unit_id",
          "obligation_ids",
          "required_origin",
          "independent_execution_class"
        ]
      }
    },
    "task_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "cwd"
        ]
      }
    }
  },
  "required": [
    "plan_id",
    "feature_id",
    "task_id",
    "feature_fingerprint",
    "profile_id",
    "profile_hash",
    "policy_checkpoint",
    "candidate_identity",
    "final_changed_surface_id",
    "origin_binding",
    "schema_version",
    "task_attempt",
    "lifecycle_generation",
    "family",
    "obligations",
    "execution_units",
    "task_commands"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification execution plan v2",
  "description": "Deep identities, trusted profile permissions and canonical planner reconstruction are additionally enforced by authority.validate_plan_record."
}
