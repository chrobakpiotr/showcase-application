<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="r03-outbox-claims" author="cp">

        <addColumn schemaName="${schema_name_full}" tableName="OUTBOX_EVENT">
            <column name="CLAIM_ID" type="VARCHAR(36)" />
            <column name="CLAIM_UNTIL" type="TIMESTAMP" />
        </addColumn>

        <createIndex indexName="IDX_OUTBOX_EVENT_STATUS_CLAIM_UNTIL_CREATED" schemaName="${schema_name_full}" tableName="OUTBOX_EVENT">
            <column name="STATUS" />
            <column name="CLAIM_UNTIL" />
            <column name="CREATED_DATE" />
        </createIndex>

    </changeSet>

</databaseChangeLog>
