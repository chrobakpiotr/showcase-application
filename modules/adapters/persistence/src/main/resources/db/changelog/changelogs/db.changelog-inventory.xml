<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="24" author="cp">

        <createTable schemaName="${schema_name_full}" tableName="STOCK_LEVEL">
            <column name="SKU" remarks="Product SKU - the business/primary key, no separate surrogate id" type="VARCHAR(40)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_STOCK_LEVEL" />
            </column>

            <column name="QUANTITY_ON_HAND" defaultValueNumeric="0" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="QUANTITY_RESERVED" defaultValueNumeric="0" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="VERSION" defaultValueNumeric="0" remarks="Optimistic-locking token, see ADR 0026" type="BIGINT">
                <constraints nullable="false" />
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
