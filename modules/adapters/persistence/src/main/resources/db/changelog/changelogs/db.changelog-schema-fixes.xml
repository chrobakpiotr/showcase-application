<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ORDER_.ORDER_NUMBER is the business key used for every order lookup (GET /order/{orderNumber}, cancellation, the order cache's key, ...) via OrderEntityRepository#getOrderEntityByOrderNumber, yet it was never indexed, forcing a full table scan on every cache miss. The value is generated as a random UUID prefix plus the cycling SEQ_ORDER_NUMBER suffix (see GenerateOrderNumberAdapter), so it 
        is - for all practical purposes - globally unique; a unique index both fixes the missing-index performance gap and turns an (extremely unlikely) generator collision into a fast, explicit DB error instead of silently overwriting/ambiguous data. -->
    <changeSet id="12" author="cp">

        <createIndex indexName="UK_ORDER_ORDER_NUMBER" schemaName="${schema_name_full}" tableName="ORDER_" unique="true">
            <column name="ORDER_NUMBER" />
        </createIndex>

    </changeSet>

    <!-- Corrects a copy-paste typo in changeSet 1: CUSTOMER.PHONE was documented as "postal code" (duplicating the POSTAL_CODE column's comment) instead of describing itself. Re-issuing the COMMENT ON COLUMN statement here - rather than editing changeSet 1 - keeps that already-applied changeset's checksum stable. -->
    <changeSet id="13" author="cp">

        <sql stripComments="true" splitStatements="true">
            comment on column ${schema_name}CUSTOMER.PHONE is 'CUSTOMER''s phone number';
        </sql>

    </changeSet>

    <!-- OrderPlacementSagaOrchestrator#publishPendingEvents polls OutboxEventEntityRepository#findAllByStatusOrderByCreatedDateAsc(PENDING) every outbox.publisher.poll-interval-ms (5s by default), i.e. this exact WHERE STATUS = ? ORDER BY CREATED_DATE query runs continuously for the lifetime of the application, yet OUTBOX_EVENT was never indexed on either column - every poll is a full table scan. 
        A composite index (rather than two single-column ones) lets the DB satisfy both the filter and the ORDER BY from the same index scan without an extra sort step. -->
    <changeSet id="14" author="cp">

        <createIndex indexName="IDX_OUTBOX_EVENT_STATUS_CREATED_DATE" schemaName="${schema_name_full}" tableName="OUTBOX_EVENT">
            <column name="STATUS" />
            <column name="CREATED_DATE" />
        </createIndex>

    </changeSet>

    <!-- FindOrdersAdapter#findAll (backing GET /api/order, the paginated order listing) sorts by CREATION_DATE descending on every call, yet the column was never indexed - degrading to a full sort of the whole table as order volume grows instead of an index-backed scan. -->
    <changeSet id="15" author="cp">

        <createIndex indexName="IDX_ORDER_CREATION_DATE" schemaName="${schema_name_full}" tableName="ORDER_">
            <column name="CREATION_DATE" />
        </createIndex>

    </changeSet>

    <!-- OrderAnalyticsEventConsumer is an at-least-once Kafka consumer (redelivery on rebalance/restart/retry), so the same order-analytics event can be consumed more than once. SaveOrderAnalyticsProjectionAdapter now relies on this unique constraint (catching the resulting DataIntegrityViolationException) to make re-processing a no-op instead of creating duplicate projection rows for the same order. -->
    <changeSet id="16" author="cp">

        <createIndex indexName="UK_ORDER_ANALYTICS_PROJECTION_ORDER_NUMBER" schemaName="${schema_name_full}" tableName="ORDER_ANALYTICS_PROJECTION" unique="true">
            <column name="ORDER_NUMBER" />
        </createIndex>

    </changeSet>

</databaseChangeLog>
