{
  "schema_version": 1,
  "name": "baseline",
  "description": "Offline final-baseline protocol checks. No model and no remote mutation.",
  "cases": [
    {
      "id": "E001-self-validate",
      "command": [
        "python3",
        "etc/agent-harness/harness.py",
        "validate",
        "docs/specs/SDD-001"
      ],
      "expected_exit": 0,
      "stdout_contains": [
        "PASS: feature specification"
      ]
    },
    {
      "id": "E002-wayfinder-map",
      "command": [
        "python3",
        "etc/agent-harness/wayfinder.py",
        "validate",
        "docs/agentic-sdd/examples/SHIP-PLATFORM-001"
      ],
      "expected_exit": 0,
      "stdout_contains": [
        "PASS"
      ]
    },
    {
      "id": "E003-wayfinder-reconciliation-blocks-fog",
      "command": [
        "python3",
        "etc/agent-harness/wayfinder.py",
        "reconcile",
        "docs/agentic-sdd/examples/SHIP-PLATFORM-001"
      ],
      "expected_exit": 2,
      "stdout_contains": [
        "RECONCILIATION BLOCKED"
      ]
    },
    {
      "id": "E004-context-trust",
      "command": [
        "python3",
        "etc/agent-harness/trust.py",
        "classify",
        ".agent-state/control-plane/github-GH-1.json"
      ],
      "expected_exit": 0,
      "stdout_contains": [
        "untrusted"
      ]
    },
    {
      "id": "E005-self-orchestration-plan",
      "command": [
        "python3",
        "etc/agent-harness/orchestrate.py",
        "docs/specs/SDD-001",
        "--plan"
      ],
      "expected_exit": 0
    },
    {
      "id": "E006-showcase-resilience-spec",
      "command": [
        "python3",
        "etc/agent-harness/harness.py",
        "validate",
        "docs/specs/DEMO-003"
      ],
      "expected_exit": 0,
      "stdout_contains": [
        "PASS"
      ]
    }
  ]
}
