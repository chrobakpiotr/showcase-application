{
  "realm": "ecommerce",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ORDER_READ",
        "description": "Allows reading orders"
      },
      {
        "name": "ORDER_WRITE",
        "description": "Allows placing orders"
      },
      {
        "name": "CATALOG_READ",
        "description": "Allows browsing the product catalog"
      },
      {
        "name": "CATALOG_WRITE",
        "description": "Allows managing categories and products"
      },
      {
        "name": "INVENTORY_READ",
        "description": "Allows reading SKU stock levels"
      },
      {
        "name": "INVENTORY_WRITE",
        "description": "Allows adjusting SKU stock levels"
      },
      {
        "name": "REVIEWS_READ",
        "description": "Allows listing reviews pending moderation"
      },
      {
        "name": "REVIEWS_WRITE",
        "description": "Allows approving or rejecting reviews"
      },
      {
        "name": "COUPON_READ",
        "description": "Allows reading coupons"
      },
      {
        "name": "COUPON_WRITE",
        "description": "Allows managing coupons"
      },
      {
        "name": "RETURN_READ",
        "description": "Allows reading return requests"
      },
      {
        "name": "RETURN_WRITE",
        "description": "Allows requesting and moderating return requests"
      },
      {
        "name": "NOTIFICATION_READ",
        "description": "Allows reading notification log entries"
      },
      {
        "name": "SHIPMENT_READ",
        "description": "Allows reading shipments"
      },
      {
        "name": "SHIPMENT_WRITE",
        "description": "Allows creating and advancing shipments"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-app",
      "name": "E-commerce showcase client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:9080/home",
        "http://localhost:9080/home/*",
        "http://localhost:4200/home",
        "http://localhost:4200/home/*"
      ],
      "webOrigins": [
        "http://localhost:9080",
        "http://localhost:4200"
      ],
      "protocolMappers": [
        {
          "name": "ecommerce-app-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ecommerce-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "order-admin",
      "enabled": true,
      "email": "order-admin@example.com",
      "emailVerified": true,
      "firstName": "Order",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORDER_READ",
        "ORDER_WRITE",
        "CATALOG_READ",
        "CATALOG_WRITE",
        "INVENTORY_READ",
        "INVENTORY_WRITE",
        "REVIEWS_READ",
        "REVIEWS_WRITE",
        "COUPON_READ",
        "COUPON_WRITE",
        "RETURN_READ",
        "RETURN_WRITE",
        "NOTIFICATION_READ",
        "SHIPMENT_READ",
        "SHIPMENT_WRITE"
      ]
    },
    {
      "username": "order-viewer",
      "enabled": true,
      "email": "order-viewer@example.com",
      "emailVerified": true,
      "firstName": "Order",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ORDER_READ",
        "CATALOG_READ",
        "INVENTORY_READ",
        "REVIEWS_READ",
        "COUPON_READ",
        "RETURN_READ",
        "NOTIFICATION_READ",
        "SHIPMENT_READ"
      ]
    }
  ]
}
